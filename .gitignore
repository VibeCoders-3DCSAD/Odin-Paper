# Local AI assistant state and guidance
# Bare names match at any depth, so a new AGENTS.md in any folder is
# ignored without a per-folder entry. Tracked AGENTS.md files (the root
# navigation guide) stay tracked: gitignore only applies to untracked files.
.codex
.claude
CLAUDE.md
AGENTS.md

# Office temporary/lock files
~$*
.~lock.*#

# Python
__pycache__/
*.pyc
*.pyo

# Environment variables
.env

# Token cache
*.pickle

# Virtual environment
.venv

# Local mirrors of Google Drive
google-drive/

# Survey raw responses (contain personal data; only the findings summary is committed)
docs/assessment-evaluation/survey/PUEPS-responses.csv

# Large local-only working reference (21 MB .docx; not committed)
formats-templates/Reference Thesis (Group 10).docx
